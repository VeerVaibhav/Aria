# APIx — National Airfare Price Index (SIH26056)
# Copy to .env.local and fill with your Supabase project credentials.
# NEVER commit real keys.

# Public (browser-safe) Supabase credentials — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-public-key>

# Server-side only — used by scripts/ and worker/ (bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# Optional: direct Postgres credentials for schema deployment and bulk
# seeding (scripts/deploy_schema.py, scripts/seed_historical.py)
SUPABASE_DB_HOST=db.<your-project-ref>.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=<your-db-password>
